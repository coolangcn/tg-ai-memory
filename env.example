# ===== Telegram 用户账号 (Telethon) =====
# 在 https://my.telegram.org → API development tools 获取
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 登录手机号（格式：+8613800138000）
TELEGRAM_PHONE=
# 两步验证密码（如开启了两步验证才需要）
TELEGRAM_PASSWORD=

# ===== 采集目标 =====
# 要采集的频道/群，逗号分隔（@用户名 或 数字ID）
# 只需你的账号有访问权限（已订阅/已加入）即可，无需管理权限
WATCH_CHANNELS=@SZnewls

# ===== 每日精华 =====
# 每日精华发送到哪：'me' = 私密收藏(Saved Messages)，或 @用户名 / 数字ID
SUMMARY_CHAT_ID=me
# 发送时间（24小时制，按服务器本地时区），默认 23:59
REPORT_TIME=23:59

# ===== Google Gemini =====
GEMINI_API_KEY=

# ===== PostgreSQL =====
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
